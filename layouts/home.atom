{{- /*
  The releases feed, /releases.atom: the newest 20 entries of data/releases/.
  Its shape follows GrapheneOS's releases feed (generate-feed, MIT, see NOTICE).
  Ids stay on https://diamaneos.de whatever the baseURL, so they never change.
  Atom needs a feed date even with no entries. 1970 stands in until the first.
*/ -}}
{{- $page := site.GetPage "/releases" }}
{{- $releases := first 20 (partial "releases.html" .) }}
{{- $updated := "1970-01-01T00:00:00Z" }}
{{- range first 1 $releases }}{{ $updated = .time.Format "2006-01-02T15:04:05Z" }}{{ end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <id>https://diamaneos.de/releases/</id>
  <title>DiamaneOS releases</title>
  <link rel="self" type="application/atom+xml" href="{{ (.OutputFormats.Get "atom").Permalink }}"/>
  <link rel="alternate" type="text/html" href="{{ $page.Permalink }}"/>
  <icon>{{ "favicon.svg" | absURL }}</icon>
  <updated>{{ $updated }}</updated>
  <author>
    <name>DiamaneOS</name>
    <uri>{{ site.Home.Permalink }}</uri>
  </author>
  {{- range $releases }}
  {{- $time := .time.Format "2006-01-02T15:04:05Z" }}
  {{- $html := printf "<p>Channels: %s</p>\n%s" (delimit .channels ", ") ($page.RenderString (dict "display" "block") .notes) }}
  {{- $html = replaceRE `href="/` (printf `href="%s` site.BaseURL) $html }}
  {{- $html = replaceRE `href="#` (printf `href="%s#` $page.Permalink) $html }}
  <entry>
    <id>https://diamaneos.de/releases/#{{ .version }}</id>
    <title>{{ .version }}</title>
    <link rel="alternate" type="text/html" href="{{ $page.Permalink }}#{{ .version }}"/>
    <published>{{ $time }}</published>
    <updated>{{ $time }}</updated>
    {{- range .channels }}
    <category term="{{ lower . }}" label="{{ . }}"/>
    {{- end }}
    <content type="html">{{ $html | transform.XMLEscape | safeHTML }}</content>
  </entry>
  {{- end }}
</feed>
